{
  "name": "Xotiic Upload | Artist Console",
  "short_name": "Xotiic Upload",
  "description": "Private release publishing for XotiicDuck Music.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#050705",
  "theme_color": "#050705",
  "orientation": "any",
  "categories": ["music", "productivity"],
  "prefer_related_applications": false,
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "audio", "accept": ["audio/mpeg", ".mp3"] },
        { "name": "cover", "accept": ["image/jpeg", "image/png", "image/webp"] }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?panel=upload",
      "accept": {
        "audio/mpeg": [".mp3"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/webp": [".webp"]
      }
    }
  ],
  "shortcuts": [
    { "name": "New release", "short_name": "Upload", "url": "./?panel=upload", "icons": [{ "src": "../icon-192.png?v=18", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Manage music", "short_name": "Releases", "url": "./?panel=releases", "icons": [{ "src": "../icon-192.png?v=18", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Release calendar", "short_name": "Calendar", "url": "./?panel=overview", "icons": [{ "src": "../icon-192.png?v=18", "sizes": "192x192", "type": "image/png" }] }
  ],
  "icons": [
    { "src": "../icon-192.png?v=18", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../icon-512.png?v=18", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../icon-maskable-192.png?v=18", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "../icon-maskable-512.png?v=18", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
